# ============================================================
# Cliopatra Social — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
#
# Everything below is a frontend variable: Vite inlines it into the
# bundle at build time, so none of these may hold a secret.
# ============================================================

# ── Supabase (required) ──────────────────────────────────────
# Found in: supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Meta / Facebook / Instagram (required for IG connect) ───
# Found in: developers.facebook.com → Your App → Settings → Basic
VITE_META_APP_ID=your_meta_app_id

# ── Threads (required for Threads connect) ──────────────────
VITE_THREADS_APP_ID=your_threads_app_id

# ── YouTube / Google (required for YouTube connect) ─────────
# Found in: console.cloud.google.com → APIs & Services → Credentials
# The redirect URI is always <origin>/auth/youtube/callback, so register
# that for each host you serve from rather than setting it here.
VITE_YOUTUBE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── OAuth redirect overrides (optional) ─────────────────────
# Both callbacks default to the origin the user is on, which is what you
# want on the web: the Supabase session and the OAuth state live in that
# origin's storage. Set these only for an origin with no routable callback
# of its own — the Capacitor webview. Must match what is registered in the
# platform's dev console exactly.
# VITE_META_REDIRECT_URI=https://yourdomain.com/auth/meta/callback
# VITE_THREADS_REDIRECT_URI=https://yourdomain.com/auth/threads/callback

# ============================================================
# Supabase Edge Function Secrets (set via Supabase dashboard)
# These are NOT frontend env vars — set them at:
# supabase.com → Project → Edge Functions → Manage secrets
# OR via: supabase secrets set KEY=value
# ============================================================
#
# Names are case-sensitive and a few are mixed case — copy them as written.
#
# ANTHROPIC_API_KEY=sk-ant-...        ← Required for ALL AI features
# META_APP_ID=...                     ← Instagram / Facebook OAuth
# META_APP_SECRET=...                 ← Instagram / Facebook OAuth
# THREADS_APP_ID=...                  ← Threads OAuth
# THREADS_APP_SECRET=...              ← Threads OAuth
# YOUTUBE_CLIENT_ID=...               ← YouTube OAuth
# YOUTUBE_CLIENT_SECRET=...           ← YouTube OAuth
# YOUTUBE_API_KEY=...                 ← Watch discovery
# BRIGHTBEAN_API_KEY=...              ← Watch discovery
# Post_For_Me_API=...                 ← Publishing and syncing via Post For Me
# Post_For_Me_Webhook_Secret=...      ← Verifies the Post For Me webhook
# Default_PFM_User_Id=...             ← Owner for cron-triggered Post For Me runs
# Cron_Secret=...                     ← Guards every scheduled / cron function
# Lead_Salt=...                       ← Salts the hashed IPs the media kit
#                                       rate-limits on (falls back to the
#                                       service key when unset)
# SUPABASE_URL=...                    ← Auto-available in edge functions
# SUPABASE_ANON_KEY=...               ← Auto-available in edge functions
# SUPABASE_SERVICE_ROLE_KEY=...       ← Auto-available in edge functions
